# cuora.toml — per-repo config for the cuora CLI. Search order:
# --config → $CUORA_CONFIG → ./cuora.toml → ~/.config/cuora/cuora.toml.
# `cuora schema` emits the full machine-readable spec. Unknown keys
# fail loud. Secrets are refs, never values.

# Named vault backends. "local" is the built-in age vault and the
# default for every env that doesn't say otherwise; an entry only
# overrides its paths or adds extra recipients.
#
# [vaults.local]
# kind = "age"                                  # built-in local vault
# path = "/home/you/.local/share/cuora/vault.age"   # "~" is NOT expanded — full paths
# identity = "/home/you/.config/cuora/identity.txt"   # pins file mode — else session
                                                   # keyring → default keyfile;
                                                   # $CUORA_IDENTITY_FILE also pins
# recipients = ["age1…"]                        # extra public keys to encrypt to

# A remote vault: self-hosted Cloudflare Worker + D1 holding
# per-secret age ciphertext — the worker never sees plaintext.
# Deploy it from crates/cuora-vault-cf/worker/ first; the bearer
# token comes via the env var named by token_env, never inline.
#
# [vaults.cloud]
# kind = "cf"
# url = "https://cuora-vault.you.workers.dev"
# token_env = "CUORA_CF_TOKEN"                    # env var NAME, not the token
# identity = "/home/you/.config/cuora/identity.txt"   # optional; same resolution as local
# recipients = ["age1…"]                        # optional extra encrypt-to keys
#
# Read-through encrypted local cache (P-007) — `get`/`list` serve a
# local age vault at $XDG_CACHE_HOME/cuora/cloud.age while fresh,
# miss → remote fetch → write-through; writes always go remote
# first. Scope it: `cache = true` caches every env, a name or list
# scopes it — dev may cache, prod should live-fetch. Freshness is
# TTL-bounded (`cache_ttl_secs`, default 300); a remote failure
# falls back to the stale copy — the offline mode.
#
# cache = ["dev"]
# cache_ttl_secs = 600

# env → vault routing. dev/staging/prod always exist; unlisted envs
# route to "local". `dev = "local"` shorthand also works.
#
# [envs]
# dev = { vault = "local" }
# staging = { vault = "local" }
# prod = { vault = "cloud" }     # prod secrets live in the cf vault

# Deploy targets — write-only sinks `cuora deploy` pushes to.
# CF's account Secrets Store is the primary kind; the API token
# arrives via the env var named by token_env (default
# CLOUDFLARE_API_TOKEN). `cuora deploy cuora://x/y --target prod`.
#
# [deploy.prod]
# kind = "cf-secrets-store"
# account_id = "…"                               # CF account id
# store_id = "…"                                 # Secrets Store id
# token_env = "CLOUDFLARE_API_TOKEN"             # optional; this is the default
# base_url = "https://api.cloudflare.com/client/v4"   # optional override

# The declared secret surface: env-var name → cuora:// ref. This is
# what `cuora run`/`cuora env` may inject — least privilege, reviewable,
# `cuora check`-able. Ad-hoc `-s VAR=cuora://ref` covers one-offs.
#
# [secrets]
# STRIPE_API_KEY = "cuora://billing/stripe"
# DATABASE_URL = "cuora://db/url"

# Guardrails — advisory, deny-listed ops always lose. Accident
# prevention for standalone use, NOT a policy boundary (CUORA_ACTOR
# is self-claimed; real enforcement is peregrin's).
#
# [guardrails]
# default = "allow"              # or "deny" — ops in neither list
# allow = ["run", "list"]
# deny = ["get", "put"]

# `cuora serve` — the ndjson IPC surface orchestrators (peregrin)
# embed. With a policy decision point configured, every
# vault-touching op (get/put/rm/rotate) consults it first: the
# exec command runs once per decision, gets the request
# ({actor, attestation?, op, env, ref}) as one JSON line on
# stdin, and answers {"allow": bool, "reason"?, "obligations"?}
# on stdout. Unreachable/unparseable fails CLOSED unless
# allow_on_error — an unanswered policy engine must not mean
# "allowed". Actor/attestation are advisory claims; real signing
# is the PDP's side.
#
# [serve.pdp]
# exec = "peregrin policy decide"   # sh -c per decision — stdin request, stdout verdict
# allow_on_error = false            # default: fail closed when the PDP can't answer
